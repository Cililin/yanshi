{
  "openapi": "3.0.0",
  "info": {
    "title": "研时-考研时政智能分析系统 API 测试用例",
    "version": "1.0.0",
    "description": "Apifox 测试用例集合，包含所有接口的测试示例"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "本地开发环境"
    }
  ],
  "paths": {
    "/articles": {
      "get": {
        "summary": "分页查询文章列表",
        "tags": ["文章管理"],
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "description": "文章标题（模糊查询）",
            "schema": {
              "type": "string",
              "example": "时政"
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "文章来源",
            "schema": {
              "type": "string",
              "example": "人民日报"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "文章分类",
            "schema": {
              "type": "string",
              "example": "政治"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "开始日期",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2024-01-01"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "结束日期",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2024-12-31"
            }
          },
          {
            "name": "current",
            "in": "query",
            "description": "当前页码",
            "schema": {
              "type": "integer",
              "default": 1,
              "example": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "每页条数",
            "schema": {
              "type": "integer",
              "default": 10,
              "example": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "message": "success",
                  "data": {
                    "records": [
                      {
                        "id": 1,
                        "title": "2024年时政要闻",
                        "source": "人民日报",
                        "url": "https://example.com/article/1",
                        "urlHash": "abc123def456",
                        "content": "文章正文内容...",
                        "summary": "文章摘要",
                        "keywords": "时政,政治,新闻",
                        "category": "政治",
                        "publishDate": "2024-01-15",
                        "publishTime": "2024-01-15T10:30:00",
                        "crawlTime": "2024-01-15T11:00:00",
                        "importanceScore": 8.5,
                        "status": "published",
                        "createdAt": "2024-01-15T11:00:00",
                        "updatedAt": "2024-01-15T11:00:00"
                      }
                    ],
                    "total": 100,
                    "current": 1,
                    "size": 10,
                    "pages": 10
                  }
                }
              }
            }
          }
        },
        "x-apifox-folder": "文章管理"
      }
    },
