<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yanshi.mapper.KnowledgeRelationMapper">

    <select id="getRelationsByPointId" resultType="com.yanshi.entity.KnowledgeRelation">
        SELECT * FROM knowledge_relations
        WHERE source_id = #{pointId} OR target_id = #{pointId}
        ORDER BY weight DESC
    </select>

</mapper>
